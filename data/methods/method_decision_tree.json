  "origin": {
    "proposer": "决策分析领域的标准方法（具体提出者待考）",
    "firstProposedAt": null,
    "sourceIds": [
      "src_decision_tree"
    ]
  },
  "content": {
    "coreIdea": "用树状结构表达决策：每个节点是一个选择或机会事件，分支是可能的结果，叶节点是最终结局。结构化之后，选择的逻辑和风险点都变得可见。",
    "principles": [
      "节点必须是决策点或机会事件，不能混杂",
      "分支必须穷尽所有可能，不留隐含选项",
      "末端叶节点必须对应可比较的结果"
    ],
    "mechanism": "图形化把「我到底在选什么」显性化。分支的穷尽性要求迫使决策者意识到被忽略的选项，末端统一的结果维度让不同路径可直接比较。",
    "scenarios": [
      "职业路径选择",
      "技术方案选型",
      "投资决策分析",
      "风险识别与预案设计"
    ],
    "conditions": [
      "决策点数量不能太多，否则树会失控",
      "分支概率或收益需要有一定依据",
      "适合单一决策者、单一目标的决策"
    ],
    "steps": [
      "明确最终要决定什么（根节点）",
      "列出该决策下的主要选项（第一层分支）",
      "对每个选项展开后续可能情况",
      "为末端标注结果与代价",
      "比较各路径，用数据或判断收敛到决策"
    ],
    "advantages": [
      "把决策逻辑可视化，沟通效率高",
      "穷尽性要求能暴露被忽略的选项",
      "便于识别风险点与关键决策节点"
    ],
    "disadvantages": [
      "分支爆炸时难以维护",
      "概率难以准确估计时容易产生虚假精确",
      "不适合多目标同时权衡的决策"
    ],
    "limitations": [
      "不适合选项持续新增的开放性决策",
      "不适合需要实时调整的动态环境"
    ],
    "misconceptions": [
      "误以为画完树就等于做完了决策 —— 还需比较与收敛",
      "误把概率当成客观事实 —— 多数情况下的概率是主观估计",
      "误以为树能穷尽所有风险 —— 存在完全未知的风险"
    ]
  },
